{
  "compilerOptions": {
    "target": "es2020", "lib": ["dom", "esnext"], "jsx": "preserve", "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "incremental": true, "resolveJsonModule": true, "isolatedModules": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
